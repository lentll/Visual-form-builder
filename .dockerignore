# 依赖与构建产物（构建时重新生成）
node_modules
dist
dist-ssr

# 版本控制
.git
.gitignore

# IDE 与编辑器
.vscode
.idea
*.swp
*.swo

# 日志与临时文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# 环境变量（构建时按需注入，不打包进镜像）
.env
.env.*
!.env.example

# 测试与文档（不影响运行）
coverage
*.md
README.md

# 备份与打包文件
*.zip
*.tar.gz
form-builder-source.zip
form-builder-backup.tar.gz

# Docker 自身文件（避免循环引用）
Dockerfile
docker-compose.yml
docker-compose.yaml
.dockerignore
